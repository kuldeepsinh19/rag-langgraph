# PostgreSQL connection string used by the pgvector vector store.
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# Vector store backend to use. Allowed values: pgvector, qdrant.
VECTOR_STORE=pgvector

# Embedding provider. Allowed values: gemini, ollama.
EMBEDDER_PROVIDER=gemini

# Gemini API key used for embeddings. Do not commit a real key.
GEMINI_API_KEY=

# Gemini embedding model and output dimensions.
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_EMBED_DIMENSIONS=768
GEMINI_EMBED_CONCURRENCY=1
GEMINI_EMBED_DELAY_MS=1000
GEMINI_EMBED_MAX_RETRIES=3

# Base URL for the local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama embedding model name. Only used when EMBEDDER_PROVIDER=ollama.
OLLAMA_EMBED_MODEL=nomic-embed-text

# Ollama LLM model name (generation still uses local Ollama).
OLLAMA_LLM_MODEL=llama3.2

# Qdrant server URL.
QDRANT_URL=http://localhost:6333

# Qdrant collection name for document chunks.
QDRANT_COLLECTION=rag_chunks

# Maximum characters per text chunk.
CHUNK_SIZE=8000

# Number of overlapping characters between adjacent chunks.
CHUNK_OVERLAP=800

# Number of chunks to retrieve for search.
TOP_K=8

# Minimum relevance score from 0 to 1 for retrieved chunks.
MIN_RELEVANCE_SCORE=0.3

# Maximum number of query rewrite retries in the RAG graph.
MAX_REWRITE_RETRIES=2

# Maximum context characters sent to the LLM after retrieval.
MAX_CONTEXT_CHARS=12000

# Safety limits for large document ingestion.
MAX_CHUNKS_PER_DOCUMENT=500
INGEST_EMBED_BATCH_SIZE=25

# HTTP server port.
PORT=3000

# Application log level. Allowed values: info, debug, warn, error.
LOG_LEVEL=info

# Maximum uploaded file size in megabytes.
MAX_FILE_SIZE_MB=20
