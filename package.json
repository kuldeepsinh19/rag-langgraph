{
  "name": "rag-langgraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "test": "cross-env TEST_MODE=unit vitest run",
    "test:watch": "cross-env TEST_MODE=unit vitest",
    "test:integration": "cross-env TEST_MODE=integration vitest run",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "db:init": "node scripts/init-db.js",
    "services:wait": "node scripts/wait-for-services.js",
    "ollama:validate": "node scripts/validate-ollama-models.js",
    "setup": "npm run docker:up && npm run services:wait && npm run db:init && npm run ollama:validate",
    "frontend": "node frontend/server.js"
  },
  "dependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@langchain/ollama": "^1.3.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "mammoth": "^1.12.0",
    "multer": "^1.4.5-lts.1",
    "ollama": "^0.6.3",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
